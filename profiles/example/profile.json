  "commands": [
    {
      "id": "AT",
      "category": "general",
      "summary": "检测 AT 链路是否可用",
      "desc": "Attention。确认串口链路与模组 AT 固件正常。",
      "modes": [
        "run"
      ],
      "results": [
        "OK"
      ],
      "example": [
        "AT",
        "OK"
      ],
      "delay": 0.2
    },
    {
      "id": "AT?",
      "category": "general",
      "summary": "列出全部指令帮助",
      "desc": "打印所有支持指令的简短帮助。",
      "modes": [
        "run"
      ],
      "results": [
        "OK"
      ],
      "example": [
        "AT?",
        "AT+<CMD>? ...",
        "OK"
      ],
      "delay": 0.4
    },
    {
      "id": "ATZ",
      "category": "general",
      "summary": "复位整个系统",
      "desc": "NVIC 复位（含射频）。不返回状态码，重启后打印版本横幅。",
      "modes": [
        "run"
      ],
      "results": [],
      "example": [
        "ATZ",
        "APPLICATION_VERSION: V1.0.0"
      ],
      "delay": 1.5,
      "no_status": true
    },
    {
      "id": "AT+VL",
      "category": "general",
      "summary": "设置/读取日志等级",
      "desc": "verbose level 0=OFF 1=L 2=M（默认） 3=H，等级越高调试输出越多。",
      "modes": [
        "set",
        "query",
        "help"
      ],
      "params": [
        "0~3"
      ],
      "results": [
        "OK",
        "AT_PARAM_ERROR"
      ],
      "example": [
        "AT+VL=3",
        "OK"
      ],
      "delay": 0.3
    },
    {
      "id": "AT+LTIME",
      "category": "general",
      "summary": "读取本地时间（UTC 格式）",
      "desc": "返回模组本地时间与日期。",
      "modes": [
        "query"
      ],
      "results": [
        "LTIME:..."
      ],
      "example": [
        "AT+LTIME=?",
        "LTIME:14H30M00S on 28/09/2026",
        "OK"
      ],
      "delay": 0.3
    },
    {
