    {
      "id": "AT+JOIN",
      "category": "join",
      "summary": "入网（0=ABP 1=OTAA）",
      "desc": "发起网络激活。OTAA 成功返回 +EVT:JOINED，失败 +EVT:JOIN FAILED（需重发）。",
      "modes": [
        "run",
        "set"
      ],
      "results": [
        "OK",
        "+EVT:JOINED",
        "+EVT:JOIN FAILED"
      ],
      "example": [
        "AT+JOIN=1",
        "OK",
        "+EVT:JOINED"
      ],
      "delay": 0.5,
      "wait_event": 4,
      "timeout": 30
    },
    {
      "id": "AT+SEND",
      "category": "join",
      "summary": "发送数据 port:ack:payload",
      "desc": "payload 为十六进制。ack=1 为 confirmed 上行，成功追加 +EVT:SEND_CONFIRMED。未入网返回 AT_NO_NETWORK_JOINED。",
      "modes": [
        "set"
      ],
      "results": [
        "OK",
        "+EVT:SEND_CONFIRMED",
        "AT_NO_NETWORK_JOINED",
        "AT_PARAM_ERROR"
      ],
      "example": [
        "AT+SEND=10:1:68656C6C6F",
        "OK",
        "+EVT:SEND_CONFIRMED"
      ],
      "delay": 0.5
    },
    {
      "id": "AT+LINKC",
      "category": "join",
      "summary": "链路检查（LinkCheckReq）",
