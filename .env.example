# Dev-only API base: rosezm dev serves the UI on its own port, the original
# Python backend (python3 main.py --browser) owns POST /api/* on 8899 and
# answers with Access-Control-Allow-Origin: *, so the dev page calls it
# cross-origin. Production builds may keep this (localhost tool) or empty it
# for pure same-origin serving when the Python server hosts dist/.
rosezm_PUBLIC_API_BASE=http://127.0.0.1:8899
